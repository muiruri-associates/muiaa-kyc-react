{
  "name": "@muiaa/kyc-react",
  "version": "1.0.0",
  "description": "React client library for Muiaa KYC API - A complete solution for identity verification and KYC (Know Your Customer) processes",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run type-check",
    "publish": "npm run prepublishOnly && npm publish --access public"
  },
  "keywords": [
    "kyc",
    "verification",
    "identity",
    "muiaa",
    "react",
    "react-component",
    "typescript",
    "hmac",
    "api-client"
  ],
  "author": "Muiruri Associates",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/muiruri-associates/muiaa-kyc-react.git"
  },
  "homepage": "https://github.com/muiruri-associates/muiaa-kyc-react#readme",
  "bugs": {
    "url": "https://github.com/muiruri-associates/muiaa-kyc-react/issues"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "rollup": "^4.6.1",
    "rollup-plugin-dts": "^6.1.0",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {}
}

